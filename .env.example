# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Mod Organizer 2 instance folder (contains mods/ and profiles/). Required.
MO2_PATH=C:\path\to\Mod Organizer 2

# Profile to export.
MO2_PROFILE=Default

# Snapshot name: saved to lists/<name>/ (default: the profile name).
MO2_LIST_NAME=wip

# Optional: personal key from nexusmods.com -> Site preferences -> API Keys.
# Enables the official one-line mod summaries. Leave empty to skip.
NEXUS_API_KEY=
